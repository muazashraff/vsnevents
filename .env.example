# Formspree form IDs — create two forms at https://formspree.io and paste
# their IDs here (the part after /f/ in the endpoint URL Formspree gives you).
# Until these are set, both forms on /contact will show an inline
# "not connected yet" message instead of silently failing.
NEXT_PUBLIC_FORMSPREE_GENERAL_ID=
NEXT_PUBLIC_FORMSPREE_CONSULTATION_ID=
